{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node 3JSE_Harness_v0.1/scripts/verify-harness.mjs >/dev/null 2>&1 || echo '3JSE: harness verify FAILED — run `pnpm verify:harness` and fix before finishing.'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/hook-asset-provenance.mjs"
          }
        ]
      }
    ]
  }
}
